#!/usr/bin/env bash
# Hanes CPENT harness dispatcher. Run from the repo root.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
cd "$ROOT"
export HANES_ENGAGEMENT="${HANES_ENGAGEMENT:-engagement}"

usage() {
  cat <<'EOF'
cpent — Hanes CPENT engagement harness

  TRACKING
  cpent scope add <cidr> [label]     record an authorized target range
  cpent scope list / check <ip>      list or verify scope
  cpent cred add --ip .. --user .. [--pass ..|--hash ..] --source ..
  cpent cred list / find <ip>        show or search credentials
  cpent finding new --ip .. --zone .. --sev .. --title ".."
  cpent finding list                 list all findings with severity/zone
  cpent target note <ip>             create/open a per-target note

  AUTOMATION
  cpent ev <cmd> --ip <ip>           run command, auto-save evidence + detect creds/NICs
  cpent ev-scan <target> [--type discovery|full|service|vuln]
  cpent ev-proof --ip <ip> [--os linux|windows]   capture proof-of-access + screenshot
  cpent screenshot --ip <ip>         take an annotated screenshot (IP + timestamp overlay)

  DASHBOARD
  cpent next                         ROI prioritizer: what to work on now
  cpent summary                      full engagement dashboard (zone coverage, alerts, creds)
  cpent status                       one-line status
  cpent start                        start the session timer (run this at exam start!)
  cpent report                       assemble the EC-Council report from findings

Zones: network-system active-directory binary web iot-wireless
       defense-evasion privesc pivoting reporting
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  scope|cred|finding|target|next) exec python3 "$HERE/track.py" "$cmd" "$@" ;;
  report)                         exec python3 "$HERE/genreport.py" "$@" ;;
  ev)                             exec python3 "$HERE/evidence.py" capture "$@" ;;
  ev-scan)                        exec python3 "$HERE/evidence.py" scan "$@" ;;
  ev-proof)                       exec python3 "$HERE/evidence.py" proof "$@" ;;
  screenshot)                     exec python3 "$HERE/evidence.py" screenshot "$@" ;;
  summary)                        exec python3 "$HERE/summary.py" generate "$@" ;;
  status)                         exec python3 "$HERE/summary.py" quick "$@" ;;
  start)                          exec python3 "$HERE/summary.py" start-timer "$@" ;;
  help|-h|--help|"")              usage ;;
  *) echo "unknown command: $cmd" >&2; usage; exit 1 ;;
esac
