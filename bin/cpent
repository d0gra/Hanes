#!/usr/bin/env bash
# Hanes CPENT harness dispatcher. Run from the repo root.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
cd "$ROOT"
export HANES_ENGAGEMENT="${HANES_ENGAGEMENT:-engagement}"

usage() {
  cat <<'EOF'
cpent — Hanes CPENT engagement harness

  TRACKING
  cpent scope add <cidr> [cidr2 ..] [label]  add target range(s) — bare IPs ok
  cpent scope set <cidr> [cidr2 ..]          replace entire scope in one shot
  cpent scope list / check <ip> / clear      list, verify, or wipe scope
  cpent cred add --ip .. --user .. [--pass ..|--hash ..] --source ..
  cpent cred list / find <ip>        show or search credentials
  cpent finding new --ip .. --zone .. --sev .. --title ".."
  cpent finding list                 list all findings with severity/zone
  cpent target note <ip>             create/open a per-target note
  cpent reset                        wipe all engagement state for a fresh run

  AUTOMATION (local or remote)
  cpent ev <cmd> --ip <ip> [--remote ssh|winrm|pth --user .. --secret ..]
  cpent ev-scan <target> [--type discovery|full|service|vuln] [--proxychains]
  cpent ev-proof --ip <ip> [--os linux|windows] [--remote ssh --user .. --secret ..]
  cpent ev-triage --ip <ip> [--os linux|windows] [--remote ssh --user .. --secret ..]
  cpent screenshot --ip <ip>         take annotated screenshot (IP + timestamp overlay)

  KALI ENVIRONMENT
  cpent kali-check                   verify tools, wordlists, VPN, proxychains
  cpent wordlist [password|directory|username|dns|brute-small|brute-full]
  cpent vpn                          show VPN/tunnel interface
  cpent impacket <tool.py>           find the right impacket binary name

  DASHBOARD
  cpent next                         ROI prioritizer: what to work on now
  cpent summary                      full engagement dashboard (zone coverage, alerts, creds)
  cpent status                       one-line status
  cpent start                        start the session timer (run this at exam start!)
  cpent report                       assemble the EC-Council report from findings

Zones: network-system active-directory binary web iot-wireless
       defense-evasion privesc pivoting reporting
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  scope|cred|finding|target|next|reset) exec python3 "$HERE/track.py" "$cmd" "$@" ;;
  report)                         exec python3 "$HERE/genreport.py" "$@" ;;
  ev)                             exec python3 "$HERE/evidence.py" capture "$@" ;;
  ev-scan)                        exec python3 "$HERE/evidence.py" scan "$@" ;;
  ev-proof)                       exec python3 "$HERE/evidence.py" proof "$@" ;;
  ev-triage)                      exec python3 "$HERE/evidence.py" triage "$@" ;;
  screenshot)                     exec python3 "$HERE/evidence.py" screenshot "$@" ;;
  kali-check|kali)                exec python3 "$HERE/kali.py" check "$@" ;;
  wordlist)                       exec python3 "$HERE/kali.py" wordlist "$@" ;;
  vpn)                            exec python3 "$HERE/kali.py" vpn "$@" ;;
  impacket)                       exec python3 "$HERE/kali.py" impacket "$@" ;;
  summary)                        exec python3 "$HERE/summary.py" generate "$@" ;;
  status)                         exec python3 "$HERE/summary.py" quick "$@" ;;
  start)                          exec python3 "$HERE/summary.py" start-timer "$@" ;;
  help|-h|--help|"")              usage ;;
  *) echo "unknown command: $cmd" >&2; usage; exit 1 ;;
esac
